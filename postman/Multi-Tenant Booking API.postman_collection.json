                  "});",
                  "pm.test('New booking defaults to PENDING and stores its id', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.status).to.eql('PENDING');",
                  "    pm.collectionVariables.set('bookingId', body.data.id);",
                  "});"
