          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Required on every POST. Postman's {{$guid}} dynamic variable generates a fresh key each time this specific request is sent -- fine here since this request is just demonstrating a normal create, not the replay/conflict behavior (see the dedicated Idempotency folder for that)."
