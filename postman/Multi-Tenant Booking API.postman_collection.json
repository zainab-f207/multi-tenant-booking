{
  "info": {
    "_postman_id": "aa4aac49-412a-4684-9cae-d85797e6b51f",
    "name": "Multi-Tenant Booking API",
    "description": "Week 2 booking API for the Multi-Tenant Booking internship project. Uses real server-side, cookie-based session authentication (no JWT, no Bearer tokens) -- log in with the Login requests in the Authentication folder first; Postman's cookie jar stores the httpOnly `session_token` cookie automatically and reuses it for every later request to {{baseUrl}}. tenantId is never sent by the client anywhere in this collection -- it is always derived server-side from the session, matching the project's security model.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "46624046",
    "_collection_link": "https://go.postman.co/collection/46624046-aa4aac49-412a-4684-9cae-d85797e6b51f?source=collection_link"
  },
  "item": [
