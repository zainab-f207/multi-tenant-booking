    {
      "name": "Bookings",
      "item": [
        {
          "name": "List Bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List succeeds with 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has a bookings array and pagination', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.bookings).to.be.an('array');",
                  "    pm.expect(body.data.pagination).to.have.property('total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "description": "Lists bookings belonging ONLY to the authenticated user's tenant. tenantId is never sent by the client -- isolation is enforced server-side via withTenantContext() + PostgreSQL Row-Level Security. Requires VIEW_BOOKINGS. Run a Login request first. Response: `{ success: true, data: { bookings: [...], pagination: { page, pageSize, total } } }`, ordered by startTime ascending."
          },
          "response": []
        },
