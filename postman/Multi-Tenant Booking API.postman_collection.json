    {
      "name": "Idempotency",
      "item": [
        {
          "name": "1. Create Booking - First Request (generates idempotencyKey)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('First request creates with 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Booking id stored for comparison', function () {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('idempotencyDemoBookingId', body.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Idempotency demo booking\",\n  \"startTime\": \"2026-10-02T09:00:00.000Z\",\n  \"endTime\": \"2026-10-02T09:30:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "description": "Run this request FIRST in this folder. Its pre-request script generates a brand-new key into the {{idempotencyKey}} collection variable, which the next two requests deliberately reuse. Expected: 201, a new booking is created, and its response (status + body) is stored server-side against this key."
          },
          "response": []
        },
        {
          "name": "2. Replay Same Idempotency-Key + Same Payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Replay returns the original 201, not a new resource', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Replay returns the SAME booking id as request 1', function () {",
                  "    const body = pm.response.json();",
                  "    const originalId = pm.collectionVariables.get('idempotencyDemoBookingId');",
                  "    pm.expect(body.data.id).to.eql(originalId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Idempotency demo booking\",\n  \"startTime\": \"2026-10-02T09:00:00.000Z\",\n  \"endTime\": \"2026-10-02T09:30:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "description": "SAME Idempotency-Key, SAME normalized payload as request 1. Run this request AS MANY TIMES AS YOU LIKE -- it must always return the ORIGINAL stored 201 response with the SAME booking id, and must never create a second booking. Verify this by re-running 'List Bookings' and confirming the total count did not increase."
          },
          "response": []
        },
        {
          "name": "3. Reuse Idempotency-Key + Different Payload (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
