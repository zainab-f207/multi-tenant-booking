            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ayesha.khan@technova.dev\",\n  \"password\": \"{{devPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
