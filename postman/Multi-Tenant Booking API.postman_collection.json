              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jar = pm.cookies.jar();",
                  "jar.unset(pm.variables.get('baseUrl'), 'session_token', function (error) {",
                  "    if (error) {",
                  "        console.log('Could not clear session_token cookie automatically:', error);",
                  "        console.log('If this request does not return 401, clear the session_token cookie manually via the Cookies manager and re-run it.');",
                  "    }",
                  "});"
                ]
              }
            },
