            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Team sync\",\n  \"description\": \"Weekly status update\",\n  \"startTime\": \"2026-10-01T10:00:00.000Z\",\n  \"endTime\": \"2026-10-01T10:30:00.000Z\"\n}",
